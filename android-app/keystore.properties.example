# 复制本文件为 keystore.properties 并填入你的签名信息。
# keystore.properties 已被 .gitignore 忽略，请勿提交到仓库。
# storeFile 使用相对 android-app 根目录的路径（建议纯英文，避免编码问题）。
# 生成密钥库命令：
#   keytool -genkey -v -keystore release.keystore -alias mykey -keyalg RSA -keysize 2048 -validity 10000

storeFile=release.keystore
storePassword=your_store_password
keyAlias=mykey
keyPassword=your_key_password
